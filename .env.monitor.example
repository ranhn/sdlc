# ============================================
# SDLC 安全平台 - 监控告警专用环境变量
# 部署时复制为 .env.monitor 并填入实际值
#   cp .env.monitor.example .env.monitor
#   chmod 600 .env.monitor
# ============================================

# ---- 收件人（可多个，逗号分隔）----
ALERT_EMAIL=ning.ran@vesync.com

# ---- SMTP 配置（请向 IT 申请）----
# 公司内网 SMTP（推荐，端口 25 通常无需认证）：
# SMTP_HOST=mail.vesync.com
# SMTP_PORT=25
# SMTP_FROM=sdlc-platform@vesync.com

# 外部 SMTP（如 QQ/163 邮箱，需授权码）：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_FROM=xxxx@qq.com
# SMTP_USER=xxxx@qq.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# ---- 健康检查 URL（一般无需修改）----
# HEALTH_URL=http://localhost:8000/api/health

# ---- 告警降级日志（邮件失败时写入）----
# ALERT_LOG=logs/healthcheck_alert.log
