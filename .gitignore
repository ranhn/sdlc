# ---- 运行时数据（绝不能提交）----
.env
.env.local
.env.*.local
.env.monitor
backend/security_platform.db
backend/security_platform.db-*
backend/security_platform.db.bak*
# SDLC 主库（用户/漏洞/审计等敏感数据，绝对不能进 git）
