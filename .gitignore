# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- Node / 前端 ----
node_modules/
frontend/dist/
frontend/.vite/
frontend/dev-server.log
frontend/*.yaml.tmp
# 测试输出的 accessibility tree 记录（不是源码）
/frontend/main.yaml
/frontend/after-login.yaml

# ---- 后端构建产物（前端构建输出由 FastAPI 托管）----
backend/static_new/

# ---- 运行时数据（绝不能提交）----
.env
.env.local
.env.*.local
.env.monitor
backend/security_platform.db
backend/security_platform.db-*
backend/security_platform.db.bak*
# SDLC 主库（用户/漏洞/审计等敏感数据，绝对不能进 git）
backend/sdlc.db
backend/sdlc.db-*
backend/threat/data/llm_cache.sqlite
backend/threat/data/llm_cache.sqlite-*
backend/threat/data/results/
backend/threat/data/attachments/
# 公司统一 LLM 运行时配置（含明文 api_key，禁止入仓）
backend/threat/app/services/.llm_runtime.json
backend/uploads/
# 运行时的 data 目录（SQLite 数据库），但保留 .gitkeep 占位
backend/data/*
!backend/data/.gitkeep

# 临时输出 / 启动日志 / 验证产物
backend/_out.txt
backend/_server_out.log
backend/_server_err.log
backend/_verify_result.txt
backend/_verify_*.py
backend/_verify.py
backend/_tmp_*.py
backend/_reset_*.py
backend/backend.log
backend/backend_err.log
frontend/frontend.log
frontend/vite.log
frontend/_rp_compiled.js

# ---- 备份与日志 ----
backups/
logs/
server.log
server.log.*
server_err.log
server_err.log.*

# ---- IDE / 系统 ----
.idea/
.vscode/
.codebuddy/   # CodeBuddy IDE 本地脑图/工作数据，不入仓
*.swp
.DS_Store
Thumbs.db

# ---- 测试 / 临时 ----
.coverage
htmlcov/
*.tmp
*.bak
