# ============================================
# SDLC 安全平台 - 环境变量配置模板
# 生产部署时请复制为 .env 并填入真实值
# ============================================

# ---- 安全（必须修改）----
SECRET_KEY=your-strong-secret-key-here-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS 白名单（逗号分隔，Nginx 反代时通常只需 localhost）----
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- 域名（Nginx + HTTPS 使用）----
# 生产环境替换为实际域名，如 sdlc.yourcompany.com
DOMAIN=localhost

# ---- 数据库 ----
# SQLite（开发/小规模）:
DATABASE_URL=sqlite:///./security_platform.db
# PostgreSQL（生产推荐，取消注释并填写）:
# DATABASE_URL=postgresql://user:pass@host:5432/sdlc_platform

# ---- AI 威胁建模 LLM 配置（可选）----
THREAT_API_TOKEN=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o

# ---- 飞书同步（可选，不配置则同步按钮不可用）----
# 在飞书开放平台 https://open.feishu.cn 创建企业自建应用，获取 App ID / App Secret，
# 并为应用授予"获取部门用户列表"等通讯录权限。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 默认角色 ID（同步过来的新用户使用此角色，未配置时自动用 code=employee 的角色）
FEISHU_DEFAULT_ROLE_ID=
# 默认部门 ID（飞书部门 ID 映射不到时使用）
FEISHU_DEFAULT_DEPT_ID=
# 飞书部门 ID -> 本地部门 ID 的 JSON 映射，例如 {"od-xxxxx": 1, "od-yyyyy": 2}
FEISHU_DEPT_MAP_JSON=

# ---- 上传限制 ----
MAX_UPLOAD_SIZE_MB=50