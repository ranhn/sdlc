# ============================================
# SDLC 安全平台 - 环境变量配置模板
# 生产部署时请复制为 .env 并填入真实值
# ============================================

# ---- 安全（必须修改）----
SECRET_KEY=your-strong-secret-key-here-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS 白名单（逗号分隔，Nginx 反代时通常只需 localhost）----
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- 域名（Nginx + HTTPS 使用）----
# 生产环境替换为实际域名，如 sdlc.yourcompany.com
DOMAIN=localhost

# ---- 数据库 ----
# SQLite（开发/小规模）:
DATABASE_URL=sqlite:///./security_platform.db
# PostgreSQL（生产推荐，取消注释并填写）:
# DATABASE_URL=postgresql://user:pass@host:5432/sdlc_platform

# ---- AI 威胁建模 LLM 配置（可选）----
THREAT_API_TOKEN=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o

# ---- 飞书同步（可选，不配置则同步按钮不可用）----
# 在飞书开放平台 https://open.feishu.cn 创建企业自建应用，获取 App ID / App Secret，
# 并为应用授予"获取部门用户列表"等通讯录权限。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 默认角色 ID（同步过来的新用户使用此角色，未配置时自动用 code=employee 的角色）
FEISHU_DEFAULT_ROLE_ID=
# 默认部门 ID（飞书部门 ID 映射不到时使用）
FEISHU_DEFAULT_DEPT_ID=
# 飞书部门 ID -> 本地部门 ID 的 JSON 映射，例如 {"od-xxxxx": 1, "od-yyyyy": 2}
FEISHU_DEPT_MAP_JSON=

# ---- 飞书消息通知（可选，默认开启）----
# 指定漏洞负责人时（提交时直接指定 / 指派 / 编辑里改负责人 / 修复人转派）给新负责人
# 发一条单聊消息，正文含等级、所属系统、当前状态与该漏洞的深链。
# ⚠️ 与通讯录同步是**两套独立权限**，除 contact:* 外还需要三步：
#    1) 「权限管理」开通 im:message:send_as_bot（以应用身份发送单聊消息）并**发布版本**；
#    2) 「应用能力」里**启用「机器人」** —— 漏了这步会固定报 code=230006
#       "Bot ability is not activated."（实测：权限勾对了、凭证也没问题，仍然卡在这一步）；
#    3) 接收人必须在应用的「可用范围」内。
#    发不出去时后端日志有飞书返回码（230006=机器人能力未启用、230002=接收人不在可用范围、
#    99991672=权限未开通/未发布），可直接对上排查手册。
# 负责人没有 feishu_open_id（手工建的账号）时会自动跳过，日志记一行说明。
# 应急开关：FEISHU_NOTIFY=0 可临时关闭通知，不需要改代码/发版。
FEISHU_NOTIFY=1
# 通知里那条深链用的**对外地址**（可选，生产强烈建议配置）。
# 不配则取"操作人当前访问的地址"（与 CSV/Word 导出同一套逻辑）—— 操作人若用本机/内网地址
# 操作，收件人在外面就点不开链接（后端日志会有 WARNING 提示）。
PUBLIC_BASE_URL=

# ---- 飞书同步账号的初始密码（默认 Aa123456）----
# 只作用于**从没登录过**的账号（must_change_password=True）：
#   · 「从飞书同步」新建账号时用它；已存在且从没登录过的账号也会被对齐成它；
#   · 指派漏洞给这类同事时，通知卡片里会带上「账号 + 初始密码」，首登强制改密；
#   · 已改过密码的账号**一律不动** —— 库里只有哈希，我们也发不出他的口令。
# 说明：定期更换默认口令就改这里（下次同步生效）。
FEISHU_DEFAULT_PASSWORD=Aa123456

# ---- 上传限制 ----
MAX_UPLOAD_SIZE_MB=50